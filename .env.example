# HA Kubernetes cluster inventory: verify IP allocation, subnet and NIC before deployment.
# Keepalived VIP 192.168.1.100 must be free/reserved on the masters' L2 subnet.
K8S_MINOR=v1.36
API_VIP=192.168.1.100
API_PORT=7443
MASTER1=192.168.1.10
MASTER2=192.168.1.11
MASTER3=192.168.1.12
WORKER1=192.168.1.13
WORKER2=192.168.1.14
WORKER3=192.168.1.15
WORKER4=192.168.1.16
WORKER5=192.168.1.17
# ens160 is a NIC example; replace with the real interface on each master.
VRRP_INTERFACE=ens160
# Validate Pod/Service CIDRs against site routing; they must not overlap node LAN.
POD_CIDR=10.244.0.0/16
SERVICE_CIDR=10.96.0.0/12
CILIUM_VERSION=1.20.5
